{
	"compilerOptions": {
		"target": "es2025",
		"lib": ["DOM", "DOM.Iterable", "ES2025"],
		"types": ["node"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": false,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["frontend/**/*.ts"]
}
