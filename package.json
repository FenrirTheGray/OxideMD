{
	"type": "module",
	"scripts": {
		"build:frontend": "esbuild frontend/app.ts --bundle --format=esm --splitting --target=es2025 --minify --outdir=frontend/dist --entry-names=bundle --chunk-names=chunks/[name]-[hash]",
		"watch:frontend": "esbuild frontend/app.ts --bundle --format=esm --splitting --target=es2025 --outdir=frontend/dist --entry-names=bundle --chunk-names=chunks/[name]-[hash] --watch --sourcemap",
		"typecheck": "tsc --noEmit",
		"test": "node --import tsx --test \"frontend/**/*.test.ts\""
	},
	"dependencies": {
		"@codemirror/commands": "^6.10.3",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language": "^6.12.3",
		"@codemirror/search": "^6.6.0",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.41.1",
		"@resvg/resvg-js": "^2.6.2"
	},
	"devDependencies": {
		"@types/node": "^25.9.2",
		"esbuild": "^0.28.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	},
	"allowScripts": {
		"esbuild@0.28.0": true
	}
}
